{
  "name": "lahpet-discord-bot",
  "version": "1.0.0",
  "description": "A Discord bot with web interface for movie and music recommendations",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/web/server.js",
    "start:bot": "node src/start.js",
    "start:direct": "node src/index.js",
    "start:web": "node src/web/server.js",
    "dev": "nodemon src/start.js",
    "web": "node src/web/server.js",
    "dev:web": "nodemon src/web/server.js",
    "build": "echo 'Build complete'",
    "deploy": "node src/deploy-commands.js",
    "setup": "npm install && npm run deploy",
    "docker:build": "docker build -t lahpet-bot .",
    "docker:run": "docker-compose up -d"
  },
  "keywords": [
    "discord",
    "bot",
    "recommendations",
    "movies",
    "music",
    "web-interface"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@discord-player/extractor": "^7.1.0",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.0",
    "@snazzah/davey": "^0.1.7",
    "axios": "^1.5.1",
    "cors": "^2.8.5",
    "discord-music-player": "^9.1.1",
    "discord-player": "^7.1.0",
    "discord.js": "^14.13.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.2.0",
    "helmet": "^7.1.0",
    "node-fetch": "^3.3.2",
    "play-dl": "^1.9.7",
    "simple-youtube-api": "^5.2.1",
    "youtube-dl-exec": "^3.0.25",
    "youtube-sr": "^4.3.12",
    "yt-search": "^2.13.1",
    "ytdl-core": "^4.11.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
