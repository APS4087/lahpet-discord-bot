# 🎮 LAHPET DISCORD BOT CONFIGURATION
# Copy this file to .env and fill in your values
# Get setup help: https://github.com/APS4087/lahpet-discord-bot#setup

# ============================================
# 🤖 DISCORD BOT (REQUIRED)
# ============================================
# Get these from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# Optional: For testing in specific server
DISCORD_GUILD_ID=your_test_guild_id_here

# ============================================
# 🎬 MOVIE API (OPTIONAL - FREE)
# ============================================
# Get free key from: https://www.themoviedb.org/settings/api
# Bot works with mock data if not provided
TMDB_API_KEY=your_tmdb_api_key_here

# ============================================
# 🎵 SPOTIFY API (OPTIONAL - FREE)  
# ============================================
# Get from: https://developer.spotify.com/dashboard
# Bot works with mock data if not provided
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ============================================
# 🌐 WEB SERVER
# ============================================
PORT=3000
JWT_SECRET=lahpet_super_secret_jwt_key_2024
DATABASE_URL=./data/database.sqlite

# ============================================
# 🚀 DEPLOYMENT
# ============================================
NODE_ENV=development

# For production (Railway, Render, etc):
# NODE_ENV=production